# Copie para .env (o .env real e' gitignored).
#
#   cp .env.example .env
#
# ESTE ARQUIVO E' O CORACAO DA ESTRATEGIA LOCAL-FIRST.
# Comentar as duas linhas de EMULATOR faz o MESMO codigo falar com o GCP real.

# --- Identidade do projeto -------------------------------------------------
# No emulador pode ser qualquer string. No GCP vira o project id de verdade.
GCP_PROJECT_ID=bikeflow-local

# --- Emuladores ------------------------------------------------------------
# ATENCAO a diferenca de formato entre os dois (peguei isso lendo o codigo dos
# SDKs, e' facil errar):
#   STORAGE_EMULATOR_HOST -> INCLUI o scheme (http://)
#   PUBSUB_EMULATOR_HOST  -> NAO inclui scheme, e' so host:porta
STORAGE_EMULATOR_HOST=http://localhost:4443
PUBSUB_EMULATOR_HOST=localhost:8085

# --- Data lake -------------------------------------------------------------
BIKEFLOW_BUCKET=bikeflow-lake

# --- Pub/Sub ---------------------------------------------------------------
BIKEFLOW_TOPIC=station-status
BIKEFLOW_SUBSCRIPTION=station-status-sub
BIKEFLOW_DLQ_TOPIC=station-status-dlq

# --- Warehouse local -------------------------------------------------------
# DuckDB e' embarcado: o "banco" e' este arquivo, nao um servidor.
BIKEFLOW_DUCKDB_PATH=data/bikeflow.duckdb
